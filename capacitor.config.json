{
  "appId": "com.medmate.ai.companion",
  "appName": "MedMate",
  "webDir": "frontend",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0d1520",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0d1520"
    },
    "LocalNotifications": {
      "iconColor": "#00E5FF"
    }
  }
}
