{
  "id": "com.medmate.ai.companion",
  "name": "MedMate - AI Medication Companion",
  "short_name": "MedMate",
  "description": "Zero-learning AI voice medication companion for senior citizens and caregivers. Speaks Tamil and English.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#0d1520",
  "theme_color": "#0d1520",
  "dir": "ltr",
  "lang": "en-US",
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "categories": [
    "medical",
    "health",
    "lifestyle",
    "utilities"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://kavinsusi005-oss.github.io/AI-Medication-Companion/manifest.json",
      "id": "com.medmate.ai.companion"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://kavinsusi005-oss.github.io"
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 480
  },
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+medmate",
      "url": "./index.html?action=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "Prescription Files",
      "accept": {
        "text/plain": [".txt"],
        "application/json": [".json"]
      },
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "note_taking": {
    "new_note_url": "./index.html?action=new-note"
  },
  "widgets": [
    {
      "name": "MedMate Schedule Widget",
      "description": "Quick view of due medications",
      "tag": "medmate-schedule-widget",
      "template": "widget",
      "ms_ac_template": "widget.json",
      "data": "widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "icons/screenshot-mobile.png",
          "sizes": "750x1334",
          "label": "MedMate Widget Preview"
        }
      ],
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "icons/screenshot-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "MedMate AI Voice Assistant Mobile View"
    },
    {
      "src": "icons/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "MedMate Daily Dose Timeline & Caregiver Schedule"
    }
  ],
  "shortcuts": [
    {
      "name": "Voice Assistant",
      "short_name": "Voice",
      "description": "Open MedMate AI Voice Companion",
      "url": "./index.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Schedule Timeline",
      "short_name": "Schedule",
      "description": "Check Daily Dose Timeline & Adherence",
      "url": "./calendar.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Admin Dashboard",
      "short_name": "Admin",
      "description": "Caregiver Medication Setup",
      "url": "./admin.html",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
