{
  "name": "medmate-mobile-app",
  "version": "1.0.0",
  "description": "MedMate - AI Voice Medication Companion Native Mobile App",
  "main": "frontend/index.html",
  "scripts": {
    "build": "echo 'Frontend ready for Capacitor'",
    "cap:init": "cap init MedMate com.medmate.ai.companion --web-dir frontend",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android"
  },
  "keywords": [
    "medmate",
    "pwa",
    "capacitor",
    "android",
    "voice-companion",
    "medication"
  ],
  "author": "MedMate Team",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
